        <mxCell id="pDLQpbvNaS3541XYMrP1-51" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fillColor=#ffffcc;strokeColor=#999900;fontSize=11;" value="&lt;b&gt;Campos desnormalizados (sin FK real) — flechas grises punteadas:&lt;/b&gt;&lt;br&gt;• &lt;b&gt;Bitacora.NombreMartillero&lt;/b&gt; → copia del nombre del Martillero&lt;br&gt;• &lt;b&gt;Pujas.NombreUsuario&lt;/b&gt; → copia del nombre del Usuario&lt;br&gt;• &lt;b&gt;Subastas.NombreGanador / EmailGanador&lt;/b&gt; → copia de Usuarios&lt;br&gt;• &lt;b&gt;Subastas.NombreUnidadVenta&lt;/b&gt; → copia de UnidadesDeVenta&lt;br&gt;&lt;i&gt;Se preservan en texto para que el historial sobreviva a bajas de registros.&lt;/i&gt;&lt;div&gt;&lt;i&gt;&lt;br&gt;&lt;/i&gt;&lt;/div&gt;&lt;div&gt;&lt;i&gt;&lt;div&gt;&lt;b&gt;Por qué Martilleros, Usuarios y Bitácora no tienen FK:&lt;/b&gt;&lt;/div&gt;&lt;div&gt;Es una decisión de diseño intencional. El SQL no define FK reales porque los datos de las personas se copian como texto en las tablas históricas. Es una&amp;nbsp;desnormalización intencional para integridad histórica.&lt;/div&gt;&lt;/i&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="150" width="730" x="740" y="730" as="geometry" />
        </mxCell>
        <mxCell id="pDLQpbvNaS3541XYMrP1-52" edge="1" parent="1" source="pDLQpbvNaS3541XYMrP1-8" style="dashed=1;endArrow=open;endFill=0;strokeColor=#999999;fontColor=#888888;fontSize=9;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" target="pDLQpbvNaS3541XYMrP1-1" value="NombreMartillero (sin FK)">
