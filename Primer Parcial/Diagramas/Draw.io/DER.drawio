        <mxCell id="pDLQpbvNaS3541XYMrP1-50" edge="1" parent="1" source="pDLQpbvNaS3541XYMrP1-40" style="edgeStyle=orthogonalEdgeStyle;endArrow=ERone;startArrow=ERmany;startFill=0;endFill=0;strokeColor=#d6b656;fontColor=#d6b656;fontStyle=1;fontSize=10;" target="pDLQpbvNaS3541XYMrP1-32" value="SubastaId (N:1)">
          <mxGeometry relative="1" as="geometry" />
