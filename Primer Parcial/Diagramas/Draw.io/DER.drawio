        <mxCell id="pDLQpbvNaS3541XYMrP1-49" edge="1" parent="1" source="pDLQpbvNaS3541XYMrP1-30" style="edgeStyle=orthogonalEdgeStyle;endArrow=ERone;startArrow=ERmany;startFill=0;endFill=0;strokeColor=#82b366;fontColor=#82b366;fontStyle=1;fontSize=10;entryX=0;entryY=0.75;entryDx=0;entryDy=0;exitX=0;exitY=0.5;exitDx=0;exitDy=0;" value="ContenidoId (N:1)">
