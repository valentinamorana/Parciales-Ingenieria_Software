    <!-- ══════════════════════════════════════════════
         DEPENDENCIAS  (9 flechas, sin cruzamientos)

         Estrategia de rutas:
           · Flechas horizontales: a la misma altura (sin waypoints)
           · Flechas verticales: mismo eje x (sin waypoints)
           · BLL→Seguridad: sube por la derecha de BLL,
             pasa por y=300 (hueco entre GUI y BLL) a x=1210,
             baja a Seguridad — no cruza ninguna otra flecha.
    ══════════════════════════════════════════════ -->

    <!-- 1. GUI → BLL  (vertical) -->
    <mxCell id="a1" value="«use»"
      style="dashed=1;endArrow=open;endFill=0;strokeColor=#9673a6;fontColor=#9673a6;fontSize=9;
             exitX=0.5;exitY=1;exitDx=0;exitDy=0;
             entryX=0.5;entryY=0;entryDx=0;entryDy=0;"
      edge="1" source="gui" target="bll" parent="1">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>

    <!-- 2. GUI → Seguridad  (horizontal) -->
    <mxCell id="a2" value="«use»"
      style="dashed=1;endArrow=open;endFill=0;strokeColor=#b85450;fontColor=#b85450;fontSize=9;
             exitX=1;exitY=0.5;exitDx=0;exitDy=0;
             entryX=0;entryY=0.5;entryDx=0;entryDy=0;"
      edge="1" source="gui" target="seg" parent="1">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>

    <!-- 3. BLL → Servicios  (horizontal izquierda) -->
    <mxCell id="a3" value="«use»"
      style="dashed=1;endArrow=open;endFill=0;strokeColor=#82b366;fontColor=#82b366;fontSize=9;
             exitX=0;exitY=0.5;exitDx=0;exitDy=0;
             entryX=1;entryY=0.5;entryDx=0;entryDy=0;"
      edge="1" source="bll" target="svc" parent="1">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>

    <!-- 4. BLL → DAL  (horizontal derecha) -->
    <mxCell id="a4" value="«use»"
      style="dashed=1;endArrow=open;endFill=0;strokeColor=#d6b656;fontColor=#d6b656;fontSize=9;
             exitX=1;exitY=0.5;exitDx=0;exitDy=0;
             entryX=0;entryY=0.5;entryDx=0;entryDy=0;"
      edge="1" source="bll" target="dal" parent="1">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>

    <!-- 5. BLL → Seguridad
         Sale por el techo de BLL (top, exitX=0.9 → x≈850, y=340)
         Sube a y=300 (hueco entre GUI↓260 y BLL↑340)
         Va a la derecha hasta x=1210 (centro Seguridad)
         Baja a entrar por el fondo de Seguridad (y=260)
         → No cruza ninguna de las otras flechas -->
    <mxCell id="a5" value="«use»"
      style="dashed=1;endArrow=open;endFill=0;strokeColor=#b85450;fontColor=#b85450;fontSize=9;
             exitX=0.9;exitY=0;exitDx=0;exitDy=0;
             entryX=0.5;entryY=1;entryDx=0;entryDy=0;"
      edge="1" source="bll" target="seg" parent="1">
      <mxGeometry relative="1" as="geometry">
        <Array as="points">
          <mxPoint x="850" y="300" />
          <mxPoint x="1210" y="300" />
        </Array>
      </mxGeometry>
    </mxCell>

    <!-- 6. BLL → BE  (diagonal suave, sale por el fondo izquierdo de BLL) -->
    <mxCell id="a6" value="«use»"
      style="dashed=1;endArrow=open;endFill=0;strokeColor=#9673a6;fontColor=#9673a6;fontSize=9;
             exitX=0.3;exitY=1;exitDx=0;exitDy=0;
             entryX=0.4;entryY=0;entryDx=0;entryDy=0;"
      edge="1" source="bll" target="be" parent="1">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>

    <!-- 7. Servicios → BE  (casi vertical, sale por fondo izquierdo de Servicios) -->
    <mxCell id="a7" value="«use»"
      style="dashed=1;endArrow=open;endFill=0;strokeColor=#82b366;fontColor=#82b366;fontSize=9;
             exitX=0.5;exitY=1;exitDx=0;exitDy=0;
             entryX=0.1;entryY=0;entryDx=0;entryDy=0;"
      edge="1" source="svc" target="be" parent="1">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>

    <!-- 8. DAL → BE  (diagonal, sale por fondo izquierdo de DAL → entra derecha de BE)
         DAL fondo izq: x=960+0.15*380=1017  y=630
         BE top der:    x=200+0.9*680=812     y=740
         Las dos flechas del fondo (a6 a7 a8) no se cruzan:
           a7 x≈240→268   a6 x≈610→472   a8 x≈1017→812  — rangos separados -->
    <mxCell id="a8" value="«use»"
      style="dashed=1;endArrow=open;endFill=0;strokeColor=#d6b656;fontColor=#d6b656;fontSize=9;
             exitX=0.15;exitY=1;exitDx=0;exitDy=0;
             entryX=0.9;entryY=0;entryDx=0;entryDy=0;"
      edge="1" source="dal" target="be" parent="1">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>

    <!-- 9. DAL → Interfaces  (vertical, sale por fondo derecho de DAL) -->
    <mxCell id="a9" value="«use»"
      style="dashed=1;endArrow=open;endFill=0;strokeColor=#006EAF;fontColor=#006EAF;fontSize=9;
             exitX=0.8;exitY=1;exitDx=0;exitDy=0;
             entryX=0.8;entryY=0;entryDx=0;entryDy=0;"
      edge="1" source="dal" target="iface" parent="1">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>

  </root>
</mxGraphModel>
