<?xml version="1.0" encoding="UTF-8"?>
<xmi:XMI xmi:version="2.1"
  xmlns:uml="http://www.omg.org/spec/UML/20090901"
  xmlns:xmi="http://www.omg.org/spec/XMI/20090901">

  <xmi:Documentation exporter="AlmonedaNacional-DiagramaGeneral" exporterVersion="1.0"/>

  <uml:Model xmi:type="uml:Model" xmi:id="MODEL_AN" name="LaAlmonedaNacional">
   <packagedElement xmi:type="uml:Package" xmi:id="PKG_ALL" name="AlmonedaNacional">

    <!-- ══════════ INTERFACES ══════════ -->

    <packagedElement xmi:type="uml:Interface" xmi:id="IFC_IEntidad" name="IEntidad">
      <ownedAttribute  xmi:type="uml:Property"   xmi:id="A_IE_Id"  name="Id: int" visibility="public"/>
    </packagedElement>

    <packagedElement xmi:type="uml:Interface" xmi:id="IFC_ICrud" name="ICrud&lt;T&gt;">
      <ownedOperation xmi:type="uml:Operation" xmi:id="O_IC_Guardar"  name="Guardar(entidad: T)"         visibility="public"/>
      <ownedOperation xmi:type="uml:Operation" xmi:id="O_IC_ObtTodos" name="ObtenerTodos(): IList&lt;T&gt;" visibility="public"/>
      <ownedOperation xmi:type="uml:Operation" xmi:id="O_IC_ObtId"    name="ObtenerPorId(id: int): T"    visibility="public"/>
      <ownedOperation xmi:type="uml:Operation" xmi:id="O_IC_Eliminar" name="Eliminar(entidad: T)"        visibility="public"/>
    </packagedElement>

    <packagedElement xmi:type="uml:Interface" xmi:id="IFC_IUdV" name="IUnidadDeVenta">
      <generalization xmi:type="uml:Generalization" xmi:id="G_IUdV_IE" general="IFC_IEntidad"/>
      <ownedAttribute  xmi:type="uml:Property"   xmi:id="A_IUdV_Nom"    name="Nombre: string"       visibility="public"/>
      <ownedAttribute  xmi:type="uml:Property"   xmi:id="A_IUdV_Fecha"  name="FechaIngreso: DateTime" visibility="public"/>
      <ownedAttribute  xmi:type="uml:Property"   xmi:id="A_IUdV_Estado" name="Estado: EstadoUnidad" visibility="public"/>
      <ownedOperation xmi:type="uml:Operation" xmi:id="O_IUdV_Precio" name="CalcularPrecioBase(): decimal"    visibility="public"/>
      <ownedOperation xmi:type="uml:Operation" xmi:id="O_IUdV_Desc"   name="ObtenerDescripcion(): string"    visibility="public"/>
      <ownedOperation xmi:type="uml:Operation" xmi:id="O_IUdV_Agr"    name="Agregar(u: IUnidadDeVenta): void" visibility="public"/>
      <ownedOperation xmi:type="uml:Operation" xmi:id="O_IUdV_Quit"   name="Quitar(u: IUnidadDeVenta): void"  visibility="public"/>
      <ownedOperation xmi:type="uml:Operation" xmi:id="O_IUdV_Hijos"  name="ObtenerHijos(): IList&lt;IUnidadDeVenta&gt;" visibility="public"/>
    </packagedElement>

    <packagedElement xmi:type="uml:Interface" xmi:id="IFC_ISujeto" name="ISujetoSubasta">
      <ownedOperation xmi:type="uml:Operation" xmi:id="O_IS_Suscr"  name="Suscribir(obs: IObservadorSubasta): void"   visibility="public"/>
      <ownedOperation xmi:type="uml:Operation" xmi:id="O_IS_Desus"  name="Desuscribir(obs: IObservadorSubasta): void" visibility="public"/>
      <ownedOperation xmi:type="uml:Operation" xmi:id="O_IS_Notif"  name="Notificar(mensaje: string): void"           visibility="public"/>
    </packagedElement>

    <packagedElement xmi:type="uml:Interface" xmi:id="IFC_IObs" name="IObservadorSubasta">
      <ownedOperation xmi:type="uml:Operation" xmi:id="O_IO_Act" name="Actualizar(s: SubastaActiva, msg: string): void" visibility="public"/>
    </packagedElement>

    <!-- ══════════ ENUMERACIONES ══════════ -->

    <packagedElement xmi:type="uml:Enumeration" xmi:id="ENUM_EU" name="EstadoUnidad">
      <ownedLiteral xmi:type="uml:EnumerationLiteral" xmi:id="L_EU_D" name="Disponible"/>
      <ownedLiteral xmi:type="uml:EnumerationLiteral" xmi:id="L_EU_E" name="EnSubasta"/>
      <ownedLiteral xmi:type="uml:EnumerationLiteral" xmi:id="L_EU_A" name="Adjudicado"/>
    </packagedElement>

    <packagedElement xmi:type="uml:Enumeration" xmi:id="ENUM_EP" name="EstadoPuja">
      <ownedLiteral xmi:type="uml:EnumerationLiteral" xmi:id="L_EP_A" name="Aceptada"/>
      <ownedLiteral xmi:type="uml:EnumerationLiteral" xmi:id="L_EP_R" name="Rechazada"/>
    </packagedElement>

    <packagedElement xmi:type="uml:Enumeration" xmi:id="ENUM_CE" name="CriticidadEvento">
      <ownedLiteral xmi:type="uml:EnumerationLiteral" xmi:id="L_CE_B"  name="Baja"/>
      <ownedLiteral xmi:type="uml:EnumerationLiteral" xmi:id="L_CE_M"  name="Media"/>
      <ownedLiteral xmi:type="uml:EnumerationLiteral" xmi:id="L_CE_A"  name="Alta"/>
      <ownedLiteral xmi:type="uml:EnumerationLiteral" xmi:id="L_CE_IL" name="IntentosLogin"/>
      <ownedLiteral xmi:type="uml:EnumerationLiteral" xmi:id="L_CE_BC" name="BloqueosCuenta"/>
    </packagedElement>

    <!-- ══════════ BE — ENTIDADES ══════════ -->

    <packagedElement xmi:type="uml:Class" xmi:id="CLS_Entidad" name="Entidad" isAbstract="true">
      <interfaceRealization xmi:type="uml:InterfaceRealization" xmi:id="R_Ent_IE" supplier="IFC_IEntidad" client="CLS_Entidad"/>
      <ownedAttribute xmi:type="uml:Property" xmi:id="A_Ent_Id" name="Id: int" visibility="public"/>
    </packagedElement>

    <packagedElement xmi:type="uml:Class" xmi:id="CLS_ServiceEntity" name="ServiceEntity">
      <interfaceRealization xmi:type="uml:InterfaceRealization" xmi:id="R_SE_IE" supplier="IFC_IEntidad" client="CLS_ServiceEntity"/>
      <ownedAttribute xmi:type="uml:Property" xmi:id="A_SE_Id" name="Id: int" visibility="public"/>
    </packagedElement>

    <packagedElement xmi:type="uml:Class" xmi:id="CLS_Usuario" name="Usuario">
      <generalization xmi:type="uml:Generalization" xmi:id="G_Usr_Ent" general="CLS_Entidad"/>
      <ownedAttribute xmi:type="uml:Property" xmi:id="A_Usr_Nom"   name="Nombre: string"    visibility="public"/>
      <ownedAttribute xmi:type="uml:Property" xmi:id="A_Usr_Email" name="Email: string"     visibility="public"/>
      <ownedAttribute xmi:type="uml:Property" xmi:id="A_Usr_Alta"  name="FechaAlta: DateTime" visibility="public"/>
    </packagedElement>

    <packagedElement xmi:type="uml:Class" xmi:id="CLS_Martillero" name="Martillero">
      <generalization xmi:type="uml:Generalization" xmi:id="G_Mart_Ent" general="CLS_Entidad"/>
      <ownedAttribute xmi:type="uml:Property" xmi:id="A_Mart_Nom"  name="Nombre: string"          visibility="public"/>
      <ownedAttribute xmi:type="uml:Property" xmi:id="A_Mart_User" name="Username: string"        visibility="public"/>
      <ownedAttribute xmi:type="uml:Property" xmi:id="A_Mart_Hash" name="PasswordHash: string"    visibility="public"/>
      <ownedAttribute xmi:type="uml:Property" xmi:id="A_Mart_Int"  name="IntentosFallidos: int"   visibility="public"/>
      <ownedAttribute xmi:type="uml:Property" xmi:id="A_Mart_Bloq" name="BloqueadoHasta: DateTime?" visibility="public"/>
    </packagedElement>

    <packagedElement xmi:type="uml:Class" xmi:id="CLS_ResultadoSubasta" name="ResultadoSubasta">
      <generalization xmi:type="uml:Generalization" xmi:id="G_RS_Ent" general="CLS_Entidad"/>
      <ownedAttribute xmi:type="uml:Property" xmi:id="A_RS_NomUV"  name="NombreUnidadVenta: string" visibility="public"/>
      <ownedAttribute xmi:type="uml:Property" xmi:id="A_RS_PrecioB" name="PrecioBase: decimal"      visibility="public"/>
      <ownedAttribute xmi:type="uml:Property" xmi:id="A_RS_PrecioF" name="PrecioFinal: decimal"     visibility="public"/>
      <ownedAttribute xmi:type="uml:Property" xmi:id="A_RS_Gan"    name="NombreGanador: string"    visibility="public"/>
      <ownedAttribute xmi:type="uml:Property" xmi:id="A_RS_Email"  name="EmailGanador: string"     visibility="public"/>
      <ownedAttribute xmi:type="uml:Property" xmi:id="A_RS_Fecha"  name="FechaHora: DateTime"      visibility="public"/>
    </packagedElement>

    <packagedElement xmi:type="uml:Class" xmi:id="CLS_Puja" name="Puja">
      <generalization xmi:type="uml:Generalization" xmi:id="G_Puja_Ent" general="CLS_Entidad"/>
      <ownedAttribute xmi:type="uml:Property" xmi:id="A_P_IdSub"  name="IdSubasta: int"       visibility="public"/>
      <ownedAttribute xmi:type="uml:Property" xmi:id="A_P_NomUsr" name="NombreUsuario: string" visibility="public"/>
      <ownedAttribute xmi:type="uml:Property" xmi:id="A_P_Monto"  name="Monto: decimal"        visibility="public"/>
      <ownedAttribute xmi:type="uml:Property" xmi:id="A_P_Fecha"  name="FechaHora: DateTime"   visibility="public"/>
      <ownedAttribute xmi:type="uml:Property" xmi:id="A_P_Estado" name="Estado: EstadoPuja"    visibility="public" type="ENUM_EP"/>
      <ownedAttribute xmi:type="uml:Property" xmi:id="A_P_Motivo" name="MotivoRechazo: string" visibility="public"/>
    </packagedElement>

    <packagedElement xmi:type="uml:Class" xmi:id="CLS_EventoBitacora" name="EventoBitacora">
      <generalization xmi:type="uml:Generalization" xmi:id="G_EB_Ent" general="CLS_Entidad"/>
      <ownedAttribute xmi:type="uml:Property" xmi:id="A_EB_Fecha"  name="Fecha: DateTime"           visibility="public"/>
      <ownedAttribute xmi:type="uml:Property" xmi:id="A_EB_Op"     name="Operacion: string"         visibility="public"/>
      <ownedAttribute xmi:type="uml:Property" xmi:id="A_EB_Det"    name="Detalle: string"           visibility="public"/>
      <ownedAttribute xmi:type="uml:Property" xmi:id="A_EB_Crit"   name="Criticidad: CriticidadEvento" visibility="public" type="ENUM_CE"/>
      <ownedAttribute xmi:type="uml:Property" xmi:id="A_EB_NomMart" name="NombreMartillero: string" visibility="public"/>
    </packagedElement>

    <!-- ══════════ SERVICIOS — COMPOSITE ══════════ -->

    <packagedElement xmi:type="uml:Class" xmi:id="CLS_UdVBase" name="UnidadDeVentaBase" isAbstract="true">
      <generalization       xmi:type="uml:Generalization"       xmi:id="G_UdVB_SE"   general="CLS_ServiceEntity"/>
      <interfaceRealization xmi:type="uml:InterfaceRealization" xmi:id="R_UdVB_IUdV" supplier="IFC_IUdV" client="CLS_UdVBase"/>
      <ownedAttribute xmi:type="uml:Property" xmi:id="A_UdVB_Nom"    name="Nombre: string"        visibility="public"/>
      <ownedAttribute xmi:type="uml:Property" xmi:id="A_UdVB_Fecha"  name="FechaIngreso: DateTime" visibility="public"/>
      <ownedAttribute xmi:type="uml:Property" xmi:id="A_UdVB_Estado" name="Estado: EstadoUnidad"  visibility="public" type="ENUM_EU"/>
    </packagedElement>

    <packagedElement xmi:type="uml:Class" xmi:id="CLS_Art" name="ArticuloSimple">
      <generalization xmi:type="uml:Generalization" xmi:id="G_Art_UdVB" general="CLS_UdVBase"/>
      <ownedAttribute xmi:type="uml:Property"  xmi:id="A_Art_Precio" name="PrecioBase: decimal"  visibility="public"/>
      <ownedAttribute xmi:type="uml:Property"  xmi:id="A_Art_Desc"   name="Descripcion: string"  visibility="public"/>
      <ownedOperation xmi:type="uml:Operation" xmi:id="O_Art_Precio" name="CalcularPrecioBase(): decimal"   visibility="public"/>
      <ownedOperation xmi:type="uml:Operation" xmi:id="O_Art_Desc"   name="ObtenerDescripcion(): string"   visibility="public"/>
    </packagedElement>

    <packagedElement xmi:type="uml:Class" xmi:id="CLS_Lote" name="LoteArticulos">
      <generalization xmi:type="uml:Generalization" xmi:id="G_Lote_UdVB" general="CLS_UdVBase"/>
      <ownedAttribute xmi:type="uml:Property"  xmi:id="A_Lote_Cont"  name="_contenido: IList&lt;IUnidadDeVenta&gt;" visibility="private"
                      aggregation="composite" type="IFC_IUdV" association="ASSOC_Lote_UdV">
        <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="UV_Lote" value="*"/>
        <lowerValue xmi:type="uml:LiteralInteger"          xmi:id="LV_Lote" value="0"/>
      </ownedAttribute>
      <ownedOperation xmi:type="uml:Operation" xmi:id="O_Lote_Precio" name="CalcularPrecioBase(): decimal"    visibility="public"/>
      <ownedOperation xmi:type="uml:Operation" xmi:id="O_Lote_Desc"   name="ObtenerDescripcion(): string"    visibility="public"/>
      <ownedOperation xmi:type="uml:Operation" xmi:id="O_Lote_Agr"    name="Agregar(u: IUnidadDeVenta): void" visibility="public"/>
      <ownedOperation xmi:type="uml:Operation" xmi:id="O_Lote_Quit"   name="Quitar(u: IUnidadDeVenta): void"  visibility="public"/>
    </packagedElement>

    <!-- ══════════ SERVICIOS — OBSERVER ══════════ -->

    <packagedElement xmi:type="uml:Class" xmi:id="CLS_SA" name="SubastaActiva">
      <interfaceRealization xmi:type="uml:InterfaceRealization" xmi:id="R_SA_IS" supplier="IFC_ISujeto" client="CLS_SA"/>
      <ownedAttribute xmi:type="uml:Property"  xmi:id="A_SA_Unidad"  name="Unidad: IUnidadDeVenta"
                      type="IFC_IUdV" association="ASSOC_SA_UdV">
        <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="UV_SA_UdV" value="1"/>
        <lowerValue xmi:type="uml:LiteralInteger"          xmi:id="LV_SA_UdV" value="1"/>
      </ownedAttribute>
      <ownedAttribute xmi:type="uml:Property"  xmi:id="A_SA_Precio"  name="PrecioActual: decimal"  visibility="public"/>
      <ownedAttribute xmi:type="uml:Property"  xmi:id="A_SA_Pujador" name="UltimoPujador: Usuario"
                      type="CLS_Usuario" association="ASSOC_SA_Usr">
        <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="UV_SA_Usr" value="1"/>
        <lowerValue xmi:type="uml:LiteralInteger"          xmi:id="LV_SA_Usr" value="0"/>
      </ownedAttribute>
      <ownedAttribute xmi:type="uml:Property"  xmi:id="A_SA_Activa"  name="EstaActiva: bool"       visibility="public"/>
      <ownedAttribute xmi:type="uml:Property"  xmi:id="A_SA_Pujas"   name="Pujas: IList&lt;Puja&gt;" visibility="public"/>
      <ownedAttribute xmi:type="uml:Property"  xmi:id="A_SA_Obs"     name="_observadores: IList&lt;IObservadorSubasta&gt;"
                      aggregation="shared" type="IFC_IObs" association="ASSOC_SA_Obs" visibility="private">
        <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="UV_SA_Obs" value="*"/>
        <lowerValue xmi:type="uml:LiteralInteger"          xmi:id="LV_SA_Obs" value="0"/>
      </ownedAttribute>
      <ownedOperation xmi:type="uml:Operation" xmi:id="O_SA_Suscr"   name="Suscribir(obs: IObservadorSubasta): void"   visibility="public"/>
      <ownedOperation xmi:type="uml:Operation" xmi:id="O_SA_Desus"   name="Desuscribir(obs: IObservadorSubasta): void" visibility="public"/>
      <ownedOperation xmi:type="uml:Operation" xmi:id="O_SA_Notif"   name="Notificar(mensaje: string): void"           visibility="protected"/>
      <ownedOperation xmi:type="uml:Operation" xmi:id="O_SA_Ofertar" name="RealizarOferta(u: Usuario, monto: decimal): void" visibility="public"/>
      <ownedOperation xmi:type="uml:Operation" xmi:id="O_SA_Cerrar"  name="Cerrar(): ResultadoSubasta"                visibility="public"/>
    </packagedElement>

    <packagedElement xmi:type="uml:Class" xmi:id="CLS_Interesado" name="Interesado">
      <interfaceRealization xmi:type="uml:InterfaceRealization" xmi:id="R_Int_IO" supplier="IFC_IObs" client="CLS_Interesado"/>
      <ownedAttribute xmi:type="uml:Property"  xmi:id="A_Int_Usr"  name="Usuario: Usuario"  visibility="public"/>
      <ownedAttribute xmi:type="uml:Property"  xmi:id="A_Int_Can"  name="Canal: string"     visibility="public"/>
      <ownedOperation xmi:type="uml:Operation" xmi:id="O_Int_Act"  name="Actualizar(s: SubastaActiva, msg: string): void" visibility="public"/>
    </packagedElement>

    <!-- ══════════ SERVICIOS — SINGLETON ══════════ -->

    <packagedElement xmi:type="uml:Class" xmi:id="CLS_GP" name="GestorDePujasSingleton" isFinalSpecialization="true">
      <ownedAttribute xmi:type="uml:Property"  xmi:id="A_GP_Inst"  name="_instancia: volatile GestorDePujasSingleton" visibility="private" isStatic="true"/>
      <ownedAttribute xmi:type="uml:Property"  xmi:id="A_GP_Lock"  name="_lockCreacion: object"                       visibility="private" isStatic="true"/>
      <ownedOperation xmi:type="uml:Operation" xmi:id="O_GP_GetI"  name="GetInstance(): GestorDePujasSingleton"       visibility="public"  isStatic="true"/>
      <ownedOperation xmi:type="uml:Operation" xmi:id="O_GP_Ej"    name="EjecutarBajoLock(op: Action): void"          visibility="public"/>
    </packagedElement>

    <!-- ══════════ SEGURIDAD ══════════ -->

    <packagedElement xmi:type="uml:Class" xmi:id="CLS_SM" name="SessionManager" isFinalSpecialization="true">
      <ownedAttribute xmi:type="uml:Property"  xmi:id="A_SM_Inst"  name="_instancia: volatile SessionManager"  visibility="private" isStatic="true"/>
      <ownedAttribute xmi:type="uml:Property"  xmi:id="A_SM_Mart"  name="Martillero: Martillero"              visibility="public"/>
      <ownedAttribute xmi:type="uml:Property"  xmi:id="A_SM_Log"   name="IsLoggedIn: bool"                    visibility="public"  isStatic="true"/>
      <ownedOperation xmi:type="uml:Operation" xmi:id="O_SM_GetI"  name="GetInstance(): SessionManager"       visibility="public"  isStatic="true"/>
      <ownedOperation xmi:type="uml:Operation" xmi:id="O_SM_Login" name="Login(u: string, p: string): bool"   visibility="public"  isStatic="true"/>
      <ownedOperation xmi:type="uml:Operation" xmi:id="O_SM_Logou" name="Logout()"                            visibility="public"  isStatic="true"/>
    </packagedElement>

    <!-- ══════════ DAL ══════════ -->

    <packagedElement xmi:type="uml:Class" xmi:id="CLS_Acceso" name="Acceso" isFinalSpecialization="true">
      <ownedAttribute xmi:type="uml:Property"  xmi:id="A_Acc_Inst"  name="_instancia: volatile Acceso"    visibility="private" isStatic="true"/>
      <ownedAttribute xmi:type="uml:Property"  xmi:id="A_Acc_Lock"  name="_lockCreacion: object"          visibility="private" isStatic="true"/>
      <ownedOperation xmi:type="uml:Operation" xmi:id="O_Acc_GetI"  name="GetInstance(): Acceso"          visibility="public"  isStatic="true"/>
      <ownedOperation xmi:type="uml:Operation" xmi:id="O_Acc_Leer"  name="Leer(sql): DataTable"           visibility="public"/>
      <ownedOperation xmi:type="uml:Operation" xmi:id="O_Acc_Esc"   name="Escribir(sql)"                  visibility="public"/>
      <ownedOperation xmi:type="uml:Operation" xmi:id="O_Acc_Escal" name="EjecutarEscalar(sql): int"      visibility="public"/>
      <ownedOperation xmi:type="uml:Operation" xmi:id="O_Acc_Tx"    name="EjecutarTransaccion(accion)"    visibility="public"/>
    </packagedElement>

    <packagedElement xmi:type="uml:Class" xmi:id="CLS_AbsDAL" name="AbstractDAL&lt;T&gt;" isAbstract="true">
      <interfaceRealization xmi:type="uml:InterfaceRealization" xmi:id="R_AbsDAL_IC" supplier="IFC_ICrud" client="CLS_AbsDAL"/>
      <ownedAttribute xmi:type="uml:Property"  xmi:id="A_AbsDAL_Acc"  name="_acceso: Acceso"       visibility="protected"/>
      <ownedOperation xmi:type="uml:Operation" xmi:id="O_AbsDAL_Grd"  name="Guardar()"             visibility="public" isAbstract="true"/>
      <ownedOperation xmi:type="uml:Operation" xmi:id="O_AbsDAL_ObtT" name="ObtenerTodos()"        visibility="public" isAbstract="true"/>
      <ownedOperation xmi:type="uml:Operation" xmi:id="O_AbsDAL_ObtI" name="ObtenerPorId(id: int)" visibility="public" isAbstract="true"/>
      <ownedOperation xmi:type="uml:Operation" xmi:id="O_AbsDAL_Elm"  name="Eliminar()"            visibility="public" isAbstract="true"/>
    </packagedElement>

    <packagedElement xmi:type="uml:Class" xmi:id="CLS_CatDAL" name="CatalogoDAL">
      <ownedAttribute xmi:type="uml:Property"  xmi:id="A_CatDAL_Acc" name="_acceso: Acceso"             visibility="private"/>
      <ownedOperation xmi:type="uml:Operation" xmi:id="O_CatDAL_ObtU" name="ObtenerUnidades(): DataTable"   visibility="public"/>
      <ownedOperation xmi:type="uml:Operation" xmi:id="O_CatDAL_ObtR" name="ObtenerRelaciones(): DataTable" visibility="public"/>
      <ownedOperation xmi:type="uml:Operation" xmi:id="O_CatDAL_GrdA" name="GuardarArticulo(...): int"      visibility="public"/>
      <ownedOperation xmi:type="uml:Operation" xmi:id="O_CatDAL_GrdL" name="GuardarLote(...): int"          visibility="public"/>
    </packagedElement>

    <packagedElement xmi:type="uml:Class" xmi:id="CLS_SubDAL" name="SubastaDAL">
      <generalization xmi:type="uml:Generalization" xmi:id="G_SubDAL_Abs" general="CLS_AbsDAL"/>
      <ownedOperation xmi:type="uml:Operation" xmi:id="O_SubDAL_Grd"  name="Guardar()"                visibility="public"/>
      <ownedOperation xmi:type="uml:Operation" xmi:id="O_SubDAL_ObtT" name="ObtenerTodos()"           visibility="public"/>
      <ownedOperation xmi:type="uml:Operation" xmi:id="O_SubDAL_GTx"  name="GuardarEnTransaccion(...)" visibility="public"/>
    </packagedElement>

    <packagedElement xmi:type="uml:Class" xmi:id="CLS_PujDAL" name="PujaDAL">
      <generalization xmi:type="uml:Generalization" xmi:id="G_PujDAL_Abs" general="CLS_AbsDAL"/>
      <ownedOperation xmi:type="uml:Operation" xmi:id="O_PujDAL_Grd"  name="Guardar()"                   visibility="public"/>
      <ownedOperation xmi:type="uml:Operation" xmi:id="O_PujDAL_ObtS" name="ObtenerPorSubasta(id: int)"  visibility="public"/>
      <ownedOperation xmi:type="uml:Operation" xmi:id="O_PujDAL_GTx"  name="GuardarEnTransaccion(...)"   visibility="public"/>
    </packagedElement>

    <packagedElement xmi:type="uml:Class" xmi:id="CLS_BitDAL" name="BitacoraDAL">
      <generalization xmi:type="uml:Generalization" xmi:id="G_BitDAL_Abs" general="CLS_AbsDAL"/>
      <ownedOperation xmi:type="uml:Operation" xmi:id="O_BitDAL_Grd"  name="Guardar()"          visibility="public"/>
      <ownedOperation xmi:type="uml:Operation" xmi:id="O_BitDAL_ObtF" name="ObtenerFiltrado(...)" visibility="public"/>
    </packagedElement>

    <packagedElement xmi:type="uml:Class" xmi:id="CLS_UsrDAL" name="UsuarioDAL">
      <generalization xmi:type="uml:Generalization" xmi:id="G_UsrDAL_Abs" general="CLS_AbsDAL"/>
      <ownedOperation xmi:type="uml:Operation" xmi:id="O_UsrDAL_Grd"  name="Guardar()"      visibility="public"/>
      <ownedOperation xmi:type="uml:Operation" xmi:id="O_UsrDAL_ObtT" name="ObtenerTodos()" visibility="public"/>
    </packagedElement>

    <packagedElement xmi:type="uml:Class" xmi:id="CLS_MartDAL" name="MartilleroDAL">
      <generalization xmi:type="uml:Generalization" xmi:id="G_MartDAL_Abs" general="CLS_AbsDAL"/>
      <ownedOperation xmi:type="uml:Operation" xmi:id="O_MartDAL_ObtU" name="ObtenerPorUsername(u): Martillero"    visibility="public"/>
      <ownedOperation xmi:type="uml:Operation" xmi:id="O_MartDAL_UpdI" name="ActualizarIntentosFallidos(...)"     visibility="public"/>
      <ownedOperation xmi:type="uml:Operation" xmi:id="O_MartDAL_Bloq" name="Bloquear(mart: Martillero)"          visibility="public"/>
    </packagedElement>

    <!-- ══════════ BLL ══════════ -->

    <packagedElement xmi:type="uml:Class" xmi:id="CLS_AbsBLL" name="AbstractBLL&lt;T&gt;" isAbstract="true">
      <interfaceRealization xmi:type="uml:InterfaceRealization" xmi:id="R_AbsBLL_IC" supplier="IFC_ICrud" client="CLS_AbsBLL"/>
      <ownedAttribute xmi:type="uml:Property" xmi:id="A_AbsBLL_Crud" name="_crud: ICrud&lt;T&gt;" visibility="protected"/>
    </packagedElement>

    <packagedElement xmi:type="uml:Class" xmi:id="CLS_CatBLL" name="CatalogoBLL">
      <ownedOperation xmi:type="uml:Operation" xmi:id="O_CatBLL_ObtC" name="ObtenerCatalogo(): IList&lt;IUnidadDeVenta&gt;" visibility="public"/>
      <ownedOperation xmi:type="uml:Operation" xmi:id="O_CatBLL_GrdA" name="GuardarArticulo(art: ArticuloSimple)"           visibility="public"/>
      <ownedOperation xmi:type="uml:Operation" xmi:id="O_CatBLL_GrdL" name="GuardarLote(lote: LoteArticulos)"               visibility="public"/>
    </packagedElement>

    <packagedElement xmi:type="uml:Class" xmi:id="CLS_SubBLL" name="SubastaBLL">
      <generalization xmi:type="uml:Generalization" xmi:id="G_SubBLL_Abs" general="CLS_AbsBLL"/>
      <ownedOperation xmi:type="uml:Operation" xmi:id="O_SubBLL_Crear"  name="CrearSubasta(u: IUnidadDeVenta): SubastaActiva"   visibility="public"/>
      <ownedOperation xmi:type="uml:Operation" xmi:id="O_SubBLL_Suscr"  name="Suscribir(s, obs)"                               visibility="public"/>
      <ownedOperation xmi:type="uml:Operation" xmi:id="O_SubBLL_Desus"  name="Desuscribir(s, obs)"                             visibility="public"/>
      <ownedOperation xmi:type="uml:Operation" xmi:id="O_SubBLL_Ofer"   name="RealizarOferta(s, u, monto)"                     visibility="public"/>
      <ownedOperation xmi:type="uml:Operation" xmi:id="O_SubBLL_Cerr"   name="CerrarSubasta(s): ResultadoSubasta"              visibility="public"/>
      <ownedOperation xmi:type="uml:Operation" xmi:id="O_SubBLL_Hist"   name="ObtenerHistorial(): IList&lt;ResultadoSubasta&gt;" visibility="public"/>
      <ownedOperation xmi:type="uml:Operation" xmi:id="O_SubBLL_Pujas"  name="ObtenerPujas(id): IList&lt;Puja&gt;"             visibility="public"/>
    </packagedElement>

    <packagedElement xmi:type="uml:Class" xmi:id="CLS_BitBLL" name="BitacoraBLL">
      <ownedOperation xmi:type="uml:Operation" xmi:id="O_BitBLL_Reg"   name="Registrar(op, detalle, criticidad)" visibility="public"/>
      <ownedOperation xmi:type="uml:Operation" xmi:id="O_BitBLL_ObtF"  name="ObtenerFiltrado(...): IList&lt;EventoBitacora&gt;" visibility="public"/>
    </packagedElement>

    <packagedElement xmi:type="uml:Class" xmi:id="CLS_UsrBLL" name="UsuarioBLL">
      <generalization xmi:type="uml:Generalization" xmi:id="G_UsrBLL_Abs" general="CLS_AbsBLL"/>
      <ownedOperation xmi:type="uml:Operation" xmi:id="O_UsrBLL_ObtT" name="ObtenerTodos(): IList&lt;Usuario&gt;" visibility="public"/>
    </packagedElement>

    <!-- ══════════ GUI ══════════ -->

    <packagedElement xmi:type="uml:Class" xmi:id="CLS_frmLogin"     name="frmLogin">
      <ownedOperation xmi:type="uml:Operation" xmi:id="O_frmL_Ini" name="IniciarSesion_Click()" visibility="private"/>
    </packagedElement>
    <packagedElement xmi:type="uml:Class" xmi:id="CLS_frmPrincipal" name="frmPrincipal">
      <ownedAttribute xmi:type="uml:Property"  xmi:id="A_frmP_Cat" name="_catalogo: List&lt;IUnidadDeVenta&gt;" visibility="private"/>
      <ownedAttribute xmi:type="uml:Property"  xmi:id="A_frmP_Bit" name="_bitacora: BitacoraBLL"               visibility="private"/>
    </packagedElement>
    <packagedElement xmi:type="uml:Class" xmi:id="CLS_frmCatalogo"  name="frmCatalogo">
      <ownedAttribute xmi:type="uml:Property"  xmi:id="A_frmC_Cat" name="_catalogo: List&lt;IUnidadDeVenta&gt;" visibility="private"/>
    </packagedElement>
    <packagedElement xmi:type="uml:Class" xmi:id="CLS_frmSubasta"   name="frmSubasta">
      <ownedAttribute xmi:type="uml:Property"  xmi:id="A_frmS_SA"  name="_subastaActiva: SubastaActiva"         visibility="private"/>
    </packagedElement>
    <packagedElement xmi:type="uml:Class" xmi:id="CLS_frmHistorial" name="frmHistorial"/>
    <packagedElement xmi:type="uml:Class" xmi:id="CLS_frmReporte"   name="frmReporte">
      <ownedAttribute xmi:type="uml:Property"  xmi:id="A_frmR_Cat" name="_catalogo: List&lt;IUnidadDeVenta&gt;" visibility="private"/>
    </packagedElement>
    <packagedElement xmi:type="uml:Class" xmi:id="CLS_frmBitacora"  name="frmBitacora"/>

    <!-- ══════════ ASOCIACIONES ══════════ -->

    <packagedElement xmi:type="uml:Association" xmi:id="ASSOC_SA_UdV">
