<?xml version="1.0" encoding="UTF-8"?>
<xmi:XMI xmi:version="2.1"
  xmlns:uml="http://www.omg.org/spec/UML/20090901"
  xmlns:xmi="http://www.omg.org/spec/XMI/20090901">

  <xmi:Documentation exporter="AlmonedaNacional-DiagramaCapas" exporterVersion="1.0"/>

  <uml:Model xmi:type="uml:Model" xmi:id="MODEL_AN" name="LaAlmonedaNacional">

    <!-- ═══════════════════════════════════════════════════════
         CAPA 1 — Interfaces
         ═══════════════════════════════════════════════════════ -->
    <packagedElement xmi:type="uml:Package" xmi:id="PKG_IFC" name="Interfaces">

      <packagedElement xmi:type="uml:Interface" xmi:id="IFC_IEntidad" name="IEntidad">
        <ownedAttribute xmi:type="uml:Property" xmi:id="IFC_IEntidad_Id"
                        name="Id" visibility="public"/>
      </packagedElement>

      <packagedElement xmi:type="uml:Interface" xmi:id="IFC_ICrud" name="ICrud&lt;T&gt;">
        <ownedOperation xmi:type="uml:Operation" xmi:id="IFC_ICrud_Guardar"
                        name="Guardar" visibility="public"/>
        <ownedOperation xmi:type="uml:Operation" xmi:id="IFC_ICrud_ObtenerTodos"
                        name="ObtenerTodos" visibility="public"/>
        <ownedOperation xmi:type="uml:Operation" xmi:id="IFC_ICrud_ObtenerPorId"
                        name="ObtenerPorId" visibility="public"/>
        <ownedOperation xmi:type="uml:Operation" xmi:id="IFC_ICrud_Eliminar"
                        name="Eliminar" visibility="public"/>
      </packagedElement>

    </packagedElement>

    <!-- ═══════════════════════════════════════════════════════
         CAPA 2 — BE (Business Entities)
         ═══════════════════════════════════════════════════════ -->
    <packagedElement xmi:type="uml:Package" xmi:id="PKG_BE" name="BE">

      <!-- Enumeraciones -->
      <packagedElement xmi:type="uml:Enumeration" xmi:id="ENUM_EstadoUnidad" name="EstadoUnidad">
        <ownedLiteral xmi:type="uml:EnumerationLiteral" xmi:id="LIT_EU_Disponible"  name="Disponible"/>
        <ownedLiteral xmi:type="uml:EnumerationLiteral" xmi:id="LIT_EU_EnSubasta"   name="EnSubasta"/>
        <ownedLiteral xmi:type="uml:EnumerationLiteral" xmi:id="LIT_EU_Adjudicado"  name="Adjudicado"/>
      </packagedElement>

      <packagedElement xmi:type="uml:Enumeration" xmi:id="ENUM_EstadoPuja" name="EstadoPuja">
        <ownedLiteral xmi:type="uml:EnumerationLiteral" xmi:id="LIT_EP_Aceptada"  name="Aceptada"/>
        <ownedLiteral xmi:type="uml:EnumerationLiteral" xmi:id="LIT_EP_Rechazada" name="Rechazada"/>
      </packagedElement>

      <packagedElement xmi:type="uml:Enumeration" xmi:id="ENUM_CriticidadEvento" name="CriticidadEvento">
        <ownedLiteral xmi:type="uml:EnumerationLiteral" xmi:id="LIT_CE_Baja"            name="Baja"/>
        <ownedLiteral xmi:type="uml:EnumerationLiteral" xmi:id="LIT_CE_Media"           name="Media"/>
        <ownedLiteral xmi:type="uml:EnumerationLiteral" xmi:id="LIT_CE_Alta"            name="Alta"/>
        <ownedLiteral xmi:type="uml:EnumerationLiteral" xmi:id="LIT_CE_IntentosLogin"   name="IntentosLogin"/>
        <ownedLiteral xmi:type="uml:EnumerationLiteral" xmi:id="LIT_CE_BloqueosCuenta" name="BloqueosCuenta"/>
      </packagedElement>

      <!-- Clase base abstracta -->
      <packagedElement xmi:type="uml:Class" xmi:id="CLS_Entidad" name="Entidad" isAbstract="true">
        <interfaceRealization xmi:type="uml:InterfaceRealization" xmi:id="REAL_Entidad_IEntidad"
                              supplier="IFC_IEntidad" client="CLS_Entidad"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="CLS_Entidad_Id"
                        name="Id" visibility="public"/>
      </packagedElement>

      <packagedElement xmi:type="uml:Class" xmi:id="CLS_Usuario" name="Usuario">
        <generalization xmi:type="uml:Generalization" xmi:id="GEN_Usuario_Entidad" general="CLS_Entidad"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="CLS_Usr_Nombre"    name="Nombre"    visibility="public"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="CLS_Usr_Email"     name="Email"     visibility="public"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="CLS_Usr_FechaAlta" name="FechaAlta" visibility="public"/>
      </packagedElement>

      <packagedElement xmi:type="uml:Class" xmi:id="CLS_Martillero" name="Martillero">
        <generalization xmi:type="uml:Generalization" xmi:id="GEN_Martillero_Entidad" general="CLS_Entidad"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="CLS_Mart_Nombre"    name="Nombre"           visibility="public"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="CLS_Mart_Username"  name="Username"         visibility="public"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="CLS_Mart_Hash"      name="PasswordHash"     visibility="public"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="CLS_Mart_Intentos"  name="IntentosFallidos" visibility="public"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="CLS_Mart_Bloqueado" name="BloqueadoHasta"   visibility="public"/>
      </packagedElement>

      <packagedElement xmi:type="uml:Class" xmi:id="CLS_ResultadoSubasta" name="ResultadoSubasta">
        <generalization xmi:type="uml:Generalization" xmi:id="GEN_RS_Entidad" general="CLS_Entidad"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="CLS_RS_NombreUV"      name="NombreUnidadVenta" visibility="public"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="CLS_RS_PrecioBase"    name="PrecioBase"        visibility="public"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="CLS_RS_PrecioFinal"   name="PrecioFinal"       visibility="public"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="CLS_RS_NomGanador"    name="NombreGanador"     visibility="public"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="CLS_RS_EmailGanador"  name="EmailGanador"      visibility="public"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="CLS_RS_FechaHora"     name="FechaHora"         visibility="public"/>
      </packagedElement>

      <packagedElement xmi:type="uml:Class" xmi:id="CLS_Puja" name="Puja">
        <generalization xmi:type="uml:Generalization" xmi:id="GEN_Puja_Entidad" general="CLS_Entidad"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="CLS_Puja_IdSubasta"     name="IdSubasta"     visibility="public"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="CLS_Puja_NombreUsuario" name="NombreUsuario" visibility="public"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="CLS_Puja_Monto"         name="Monto"         visibility="public"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="CLS_Puja_FechaHora"     name="FechaHora"     visibility="public"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="CLS_Puja_Estado"        name="Estado"        visibility="public" type="ENUM_EstadoPuja"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="CLS_Puja_Motivo"        name="MotivoRechazo" visibility="public"/>
      </packagedElement>

      <packagedElement xmi:type="uml:Class" xmi:id="CLS_EventoBitacora" name="EventoBitacora">
        <generalization xmi:type="uml:Generalization" xmi:id="GEN_EB_Entidad" general="CLS_Entidad"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="CLS_EB_Fecha"      name="Fecha"            visibility="public"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="CLS_EB_Operacion"  name="Operacion"        visibility="public"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="CLS_EB_Detalle"    name="Detalle"          visibility="public"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="CLS_EB_Criticidad" name="Criticidad"       visibility="public" type="ENUM_CriticidadEvento"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="CLS_EB_NomMart"    name="NombreMartillero" visibility="public"/>
      </packagedElement>

    </packagedElement>

    <!-- ═══════════════════════════════════════════════════════
         CAPA 3 — Servicios  (Composite + Observer + Singleton)
         ═══════════════════════════════════════════════════════ -->
    <packagedElement xmi:type="uml:Package" xmi:id="PKG_SVC" name="Servicios">

      <!-- ServiceEntity: puente entre Interfaces y Servicios -->
      <packagedElement xmi:type="uml:Class" xmi:id="CLS_ServiceEntity" name="ServiceEntity">
        <interfaceRealization xmi:type="uml:InterfaceRealization" xmi:id="REAL_SE_IEntidad"
                              supplier="IFC_IEntidad" client="CLS_ServiceEntity"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="CLS_SE_Id" name="Id" visibility="public"/>
      </packagedElement>

      <!-- ── Composite ─────────────────────────────────── -->
      <packagedElement xmi:type="uml:Package" xmi:id="PKG_COMP" name="Composite">

        <packagedElement xmi:type="uml:Interface" xmi:id="IFC_IUdV" name="IUnidadDeVenta">
          <generalization xmi:type="uml:Generalization" xmi:id="GEN_IUdV_IEntidad" general="IFC_IEntidad"/>
          <ownedAttribute xmi:type="uml:Property" xmi:id="IFC_IUdV_Nombre"       name="Nombre"       visibility="public"/>
          <ownedAttribute xmi:type="uml:Property" xmi:id="IFC_IUdV_FechaIngreso" name="FechaIngreso" visibility="public"/>
          <ownedAttribute xmi:type="uml:Property" xmi:id="IFC_IUdV_Estado"       name="Estado"       visibility="public" type="ENUM_EstadoUnidad"/>
          <ownedOperation xmi:type="uml:Operation" xmi:id="IFC_IUdV_CalcPrecio"  name="CalcularPrecioBase"   visibility="public"/>
          <ownedOperation xmi:type="uml:Operation" xmi:id="IFC_IUdV_ObtDesc"     name="ObtenerDescripcion"   visibility="public"/>
          <ownedOperation xmi:type="uml:Operation" xmi:id="IFC_IUdV_Agregar"     name="Agregar"              visibility="public"/>
          <ownedOperation xmi:type="uml:Operation" xmi:id="IFC_IUdV_Quitar"      name="Quitar"               visibility="public"/>
          <ownedOperation xmi:type="uml:Operation" xmi:id="IFC_IUdV_ObtHijos"    name="ObtenerHijos"         visibility="public"/>
        </packagedElement>

        <!-- Clase abstracta del Composite -->
        <packagedElement xmi:type="uml:Class" xmi:id="CLS_UdVBase" name="UnidadDeVentaBase" isAbstract="true">
          <generalization       xmi:type="uml:Generalization"       xmi:id="GEN_UdVBase_SE"    general="CLS_ServiceEntity"/>
          <interfaceRealization xmi:type="uml:InterfaceRealization" xmi:id="REAL_UdVBase_IUdV"
                                supplier="IFC_IUdV" client="CLS_UdVBase"/>
          <ownedAttribute xmi:type="uml:Property" xmi:id="CLS_Base_Nombre"       name="Nombre"       visibility="public"/>
          <ownedAttribute xmi:type="uml:Property" xmi:id="CLS_Base_FechaIngreso" name="FechaIngreso" visibility="public"/>
          <ownedAttribute xmi:type="uml:Property" xmi:id="CLS_Base_Estado"       name="Estado"       visibility="public" type="ENUM_EstadoUnidad"/>
        </packagedElement>

        <!-- Hoja (Leaf) -->
        <packagedElement xmi:type="uml:Class" xmi:id="CLS_ArticuloSimple" name="ArticuloSimple">
          <generalization xmi:type="uml:Generalization" xmi:id="GEN_Art_UdVBase" general="CLS_UdVBase"/>
          <ownedAttribute xmi:type="uml:Property"  xmi:id="CLS_Art_PrecioBase"  name="PrecioBase"  visibility="public"/>
          <ownedAttribute xmi:type="uml:Property"  xmi:id="CLS_Art_Descripcion" name="Descripcion" visibility="public"/>
          <ownedOperation xmi:type="uml:Operation" xmi:id="CLS_Art_CalcPrecio"  name="CalcularPrecioBase"  visibility="public"/>
          <ownedOperation xmi:type="uml:Operation" xmi:id="CLS_Art_ObtDesc"     name="ObtenerDescripcion"  visibility="public"/>
        </packagedElement>

        <!-- Compuesto (Composite) -->
        <packagedElement xmi:type="uml:Class" xmi:id="CLS_LoteArticulos" name="LoteArticulos">
          <generalization xmi:type="uml:Generalization" xmi:id="GEN_Lote_UdVBase" general="CLS_UdVBase"/>
          <ownedAttribute xmi:type="uml:Property"  xmi:id="CLS_Lote_Contenido"  name="_contenido: IList&lt;IUnidadDeVenta&gt;" visibility="private"/>
          <ownedOperation xmi:type="uml:Operation" xmi:id="CLS_Lote_CalcPrecio" name="CalcularPrecioBase"  visibility="public"/>
          <ownedOperation xmi:type="uml:Operation" xmi:id="CLS_Lote_ObtDesc"    name="ObtenerDescripcion"  visibility="public"/>
          <ownedOperation xmi:type="uml:Operation" xmi:id="CLS_Lote_Agregar"    name="Agregar"             visibility="public"/>
          <ownedOperation xmi:type="uml:Operation" xmi:id="CLS_Lote_Quitar"     name="Quitar"              visibility="public"/>
          <ownedOperation xmi:type="uml:Operation" xmi:id="CLS_Lote_ObtHijos"   name="ObtenerHijos"        visibility="public"/>
        </packagedElement>

      </packagedElement>

      <!-- ── Observer ───────────────────────────────────── -->
      <packagedElement xmi:type="uml:Package" xmi:id="PKG_OBS" name="Observer">

        <packagedElement xmi:type="uml:Interface" xmi:id="IFC_ISujeto" name="ISujetoSubasta">
          <ownedOperation xmi:type="uml:Operation" xmi:id="IFC_IS_Suscribir"   name="Suscribir"   visibility="public"/>
          <ownedOperation xmi:type="uml:Operation" xmi:id="IFC_IS_Desuscribir" name="Desuscribir" visibility="public"/>
          <ownedOperation xmi:type="uml:Operation" xmi:id="IFC_IS_Notificar"   name="Notificar"   visibility="public"/>
        </packagedElement>

        <packagedElement xmi:type="uml:Interface" xmi:id="IFC_IObservador" name="IObservadorSubasta">
          <ownedOperation xmi:type="uml:Operation" xmi:id="IFC_IO_Actualizar" name="Actualizar" visibility="public"/>
        </packagedElement>

        <!-- Sujeto concreto -->
        <packagedElement xmi:type="uml:Class" xmi:id="CLS_SubastaActiva" name="SubastaActiva">
          <interfaceRealization xmi:type="uml:InterfaceRealization" xmi:id="REAL_SA_ISujeto"
                                supplier="IFC_ISujeto" client="CLS_SubastaActiva"/>
          <ownedAttribute xmi:type="uml:Property"  xmi:id="CLS_SA_Unidad"        name="Unidad"        visibility="public"/>
          <ownedAttribute xmi:type="uml:Property"  xmi:id="CLS_SA_PrecioActual"  name="PrecioActual"  visibility="public"/>
          <ownedAttribute xmi:type="uml:Property"  xmi:id="CLS_SA_UltimoPujador" name="UltimoPujador" visibility="public"/>
          <ownedAttribute xmi:type="uml:Property"  xmi:id="CLS_SA_EstaActiva"    name="EstaActiva"    visibility="public"/>
          <ownedAttribute xmi:type="uml:Property"  xmi:id="CLS_SA_Pujas"         name="Pujas: IList&lt;Puja&gt;" visibility="public"/>
          <ownedAttribute xmi:type="uml:Property"  xmi:id="CLS_SA_Observadores"  name="_observadores: IList&lt;IObservadorSubasta&gt;" visibility="private"/>
          <ownedOperation xmi:type="uml:Operation" xmi:id="CLS_SA_Suscribir"     name="Suscribir"     visibility="public"/>
          <ownedOperation xmi:type="uml:Operation" xmi:id="CLS_SA_Desuscribir"   name="Desuscribir"   visibility="public"/>
          <ownedOperation xmi:type="uml:Operation" xmi:id="CLS_SA_Notificar"     name="Notificar"     visibility="protected"/>
          <ownedOperation xmi:type="uml:Operation" xmi:id="CLS_SA_RealizarOferta" name="RealizarOferta" visibility="public"/>
          <ownedOperation xmi:type="uml:Operation" xmi:id="CLS_SA_Cerrar"        name="Cerrar"        visibility="public"/>
        </packagedElement>

        <!-- Observador concreto -->
        <packagedElement xmi:type="uml:Class" xmi:id="CLS_Interesado" name="Interesado">
          <interfaceRealization xmi:type="uml:InterfaceRealization" xmi:id="REAL_Int_IObs"
                                supplier="IFC_IObservador" client="CLS_Interesado"/>
          <ownedAttribute xmi:type="uml:Property"  xmi:id="CLS_Int_Usuario" name="Usuario" visibility="public"/>
          <ownedAttribute xmi:type="uml:Property"  xmi:id="CLS_Int_Canal"   name="Canal"   visibility="public"/>
          <ownedOperation xmi:type="uml:Operation" xmi:id="CLS_Int_Actualizar" name="Actualizar" visibility="public"/>
        </packagedElement>

      </packagedElement>

      <!-- ── Singleton ──────────────────────────────────── -->
      <packagedElement xmi:type="uml:Package" xmi:id="PKG_SING" name="Singleton">

        <packagedElement xmi:type="uml:Class" xmi:id="CLS_GestorPujas"
                         name="GestorDePujasSingleton" isFinalSpecialization="true">
          <ownedAttribute xmi:type="uml:Property"  xmi:id="CLS_GP_Inst"  name="_instancia: volatile"  visibility="private" isStatic="true"/>
          <ownedAttribute xmi:type="uml:Property"  xmi:id="CLS_GP_Lock"  name="_lockCreacion"         visibility="private" isStatic="true"/>
          <ownedAttribute xmi:type="uml:Property"  xmi:id="CLS_GP_LockP" name="_lockPuja"             visibility="private"/>
          <ownedOperation xmi:type="uml:Operation" xmi:id="CLS_GP_GetInst"     name="GetInstance"     visibility="public"  isStatic="true"/>
          <ownedOperation xmi:type="uml:Operation" xmi:id="CLS_GP_EjBajoLock" name="EjecutarBajoLock" visibility="public"/>
        </packagedElement>

      </packagedElement>

    </packagedElement>

    <!-- ═══════════════════════════════════════════════════════
         CAPA 4 — Seguridad
         ═══════════════════════════════════════════════════════ -->
    <packagedElement xmi:type="uml:Package" xmi:id="PKG_SEG" name="Seguridad">

      <packagedElement xmi:type="uml:Class" xmi:id="CLS_SessionManager"
                       name="SessionManager" isFinalSpecialization="true">
        <ownedAttribute xmi:type="uml:Property"  xmi:id="CLS_SM_Inst"        name="_instancia: volatile"   visibility="private" isStatic="true"/>
        <ownedAttribute xmi:type="uml:Property"  xmi:id="CLS_SM_Lock"        name="_lock"                  visibility="private" isStatic="true"/>
        <ownedAttribute xmi:type="uml:Property"  xmi:id="CLS_SM_Martillero"  name="Martillero"             visibility="public"/>
        <ownedAttribute xmi:type="uml:Property"  xmi:id="CLS_SM_IsLoggedIn"  name="IsLoggedIn: bool"       visibility="public"  isStatic="true"/>
        <ownedAttribute xmi:type="uml:Property"  xmi:id="CLS_SM_InicioSes"   name="InicioSesion"           visibility="public"/>
        <ownedOperation xmi:type="uml:Operation" xmi:id="CLS_SM_GetInst"     name="GetInstance"            visibility="public"  isStatic="true"/>
        <ownedOperation xmi:type="uml:Operation" xmi:id="CLS_SM_Login"       name="Login"                  visibility="public"  isStatic="true"/>
        <ownedOperation xmi:type="uml:Operation" xmi:id="CLS_SM_Logout"      name="Logout"                 visibility="public"  isStatic="true"/>
      </packagedElement>

    </packagedElement>

    <!-- ═══════════════════════════════════════════════════════
         CAPA 5 — DAL (Data Access Layer)
         ═══════════════════════════════════════════════════════ -->
    <packagedElement xmi:type="uml:Package" xmi:id="PKG_DAL" name="DAL">

      <!-- Singleton de conexión -->
      <packagedElement xmi:type="uml:Class" xmi:id="CLS_Acceso"
                       name="Acceso" isFinalSpecialization="true">
        <ownedAttribute xmi:type="uml:Property"  xmi:id="CLS_Acc_Inst"      name="_instancia: volatile" visibility="private" isStatic="true"/>
        <ownedAttribute xmi:type="uml:Property"  xmi:id="CLS_Acc_Lock"      name="_lockCreacion"        visibility="private" isStatic="true"/>
        <ownedOperation xmi:type="uml:Operation" xmi:id="CLS_Acc_GetInst"   name="GetInstance"          visibility="public"  isStatic="true"/>
        <ownedOperation xmi:type="uml:Operation" xmi:id="CLS_Acc_Leer"      name="Leer"                 visibility="public"/>
        <ownedOperation xmi:type="uml:Operation" xmi:id="CLS_Acc_Escribir"  name="Escribir"             visibility="public"/>
        <ownedOperation xmi:type="uml:Operation" xmi:id="CLS_Acc_Escalar"   name="EjecutarEscalar"      visibility="public"/>
        <ownedOperation xmi:type="uml:Operation" xmi:id="CLS_Acc_Transacc"  name="EjecutarTransaccion"  visibility="public"/>
      </packagedElement>

      <!-- DAL abstracto -->
      <packagedElement xmi:type="uml:Class" xmi:id="CLS_AbsDAL"
                       name="AbstractDAL&lt;T&gt;" isAbstract="true">
        <interfaceRealization xmi:type="uml:InterfaceRealization" xmi:id="REAL_AbsDAL_ICrud"
                              supplier="IFC_ICrud" client="CLS_AbsDAL"/>
        <ownedAttribute xmi:type="uml:Property"  xmi:id="CLS_AbsDAL_Acceso"   name="_acceso"        visibility="protected"/>
        <ownedOperation xmi:type="uml:Operation" xmi:id="CLS_AbsDAL_Guardar"  name="Guardar"        visibility="public"  isAbstract="true"/>
        <ownedOperation xmi:type="uml:Operation" xmi:id="CLS_AbsDAL_ObtTodos" name="ObtenerTodos"   visibility="public"  isAbstract="true"/>
        <ownedOperation xmi:type="uml:Operation" xmi:id="CLS_AbsDAL_ObtPorId" name="ObtenerPorId"  visibility="public"  isAbstract="true"/>
        <ownedOperation xmi:type="uml:Operation" xmi:id="CLS_AbsDAL_Eliminar" name="Eliminar"      visibility="public"  isAbstract="true"/>
      </packagedElement>

      <packagedElement xmi:type="uml:Class" xmi:id="CLS_CatalogoDAL" name="CatalogoDAL">
        <ownedAttribute xmi:type="uml:Property"  xmi:id="CLS_CatDAL_Acc"     name="_acceso"             visibility="private"/>
        <ownedOperation xmi:type="uml:Operation" xmi:id="CLS_CatDAL_ObtUnd"  name="ObtenerUnidades"     visibility="public"/>
        <ownedOperation xmi:type="uml:Operation" xmi:id="CLS_CatDAL_ObtRel"  name="ObtenerRelaciones"   visibility="public"/>
        <ownedOperation xmi:type="uml:Operation" xmi:id="CLS_CatDAL_GrdArt"  name="GuardarArticulo"     visibility="public"/>
        <ownedOperation xmi:type="uml:Operation" xmi:id="CLS_CatDAL_GrdLote" name="GuardarLote"         visibility="public"/>
      </packagedElement>

      <packagedElement xmi:type="uml:Class" xmi:id="CLS_SubastaDAL" name="SubastaDAL">
        <generalization xmi:type="uml:Generalization" xmi:id="GEN_SubDAL_Abs" general="CLS_AbsDAL"/>
        <ownedOperation xmi:type="uml:Operation" xmi:id="CLS_SubDAL_Grd"    name="Guardar"               visibility="public"/>
        <ownedOperation xmi:type="uml:Operation" xmi:id="CLS_SubDAL_ObtTod" name="ObtenerTodos"          visibility="public"/>
        <ownedOperation xmi:type="uml:Operation" xmi:id="CLS_SubDAL_ObtId"  name="ObtenerPorId"         visibility="public"/>
        <ownedOperation xmi:type="uml:Operation" xmi:id="CLS_SubDAL_GrdTx"  name="GuardarEnTransaccion" visibility="public"/>
      </packagedElement>

      <packagedElement xmi:type="uml:Class" xmi:id="CLS_PujaDAL" name="PujaDAL">
        <generalization xmi:type="uml:Generalization" xmi:id="GEN_PujDAL_Abs" general="CLS_AbsDAL"/>
        <ownedOperation xmi:type="uml:Operation" xmi:id="CLS_PujDAL_Grd"       name="Guardar"               visibility="public"/>
        <ownedOperation xmi:type="uml:Operation" xmi:id="CLS_PujDAL_ObtTod"    name="ObtenerTodos"          visibility="public"/>
        <ownedOperation xmi:type="uml:Operation" xmi:id="CLS_PujDAL_ObtSub"    name="ObtenerPorSubasta"     visibility="public"/>
        <ownedOperation xmi:type="uml:Operation" xmi:id="CLS_PujDAL_GrdTx"     name="GuardarEnTransaccion"  visibility="public"/>
      </packagedElement>

      <packagedElement xmi:type="uml:Class" xmi:id="CLS_BitacoraDAL" name="BitacoraDAL">
        <generalization xmi:type="uml:Generalization" xmi:id="GEN_BitDAL_Abs" general="CLS_AbsDAL"/>
        <ownedOperation xmi:type="uml:Operation" xmi:id="CLS_BitDAL_Grd"    name="Guardar"           visibility="public"/>
        <ownedOperation xmi:type="uml:Operation" xmi:id="CLS_BitDAL_ObtTod" name="ObtenerTodos"      visibility="public"/>
        <ownedOperation xmi:type="uml:Operation" xmi:id="CLS_BitDAL_ObtFil" name="ObtenerFiltrado"   visibility="public"/>
      </packagedElement>

      <packagedElement xmi:type="uml:Class" xmi:id="CLS_UsuarioDAL" name="UsuarioDAL">
        <generalization xmi:type="uml:Generalization" xmi:id="GEN_UsrDAL_Abs" general="CLS_AbsDAL"/>
        <ownedOperation xmi:type="uml:Operation" xmi:id="CLS_UsrDAL_Grd"    name="Guardar"       visibility="public"/>
        <ownedOperation xmi:type="uml:Operation" xmi:id="CLS_UsrDAL_ObtTod" name="ObtenerTodos"  visibility="public"/>
      </packagedElement>

      <packagedElement xmi:type="uml:Class" xmi:id="CLS_MartilleroDAL" name="MartilleroDAL">
        <generalization xmi:type="uml:Generalization" xmi:id="GEN_MartDAL_Abs" general="CLS_AbsDAL"/>
        <ownedOperation xmi:type="uml:Operation" xmi:id="CLS_MartDAL_ObtUser"  name="ObtenerPorUsername"         visibility="public"/>
        <ownedOperation xmi:type="uml:Operation" xmi:id="CLS_MartDAL_ActIntentos" name="ActualizarIntentosFallidos" visibility="public"/>
        <ownedOperation xmi:type="uml:Operation" xmi:id="CLS_MartDAL_Bloquear"  name="Bloquear"                   visibility="public"/>
      </packagedElement>

    </packagedElement>

    <!-- ═══════════════════════════════════════════════════════
         CAPA 6 — BLL (Business Logic Layer)
         ═══════════════════════════════════════════════════════ -->
    <packagedElement xmi:type="uml:Package" xmi:id="PKG_BLL" name="BLL">

      <packagedElement xmi:type="uml:Class" xmi:id="CLS_AbsBLL"
                       name="AbstractBLL&lt;T&gt;" isAbstract="true">
        <interfaceRealization xmi:type="uml:InterfaceRealization" xmi:id="REAL_AbsBLL_ICrud"
                              supplier="IFC_ICrud" client="CLS_AbsBLL"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="CLS_AbsBLL_Crud" name="_crud" visibility="protected"/>
      </packagedElement>

      <packagedElement xmi:type="uml:Class" xmi:id="CLS_CatalogoBLL" name="CatalogoBLL">
        <ownedOperation xmi:type="uml:Operation" xmi:id="CLS_CatBLL_ObtCat"  name="ObtenerCatalogo"  visibility="public"/>
        <ownedOperation xmi:type="uml:Operation" xmi:id="CLS_CatBLL_GrdArt"  name="GuardarArticulo"  visibility="public"/>
        <ownedOperation xmi:type="uml:Operation" xmi:id="CLS_CatBLL_GrdLote" name="GuardarLote"      visibility="public"/>
      </packagedElement>

      <packagedElement xmi:type="uml:Class" xmi:id="CLS_SubastaBLL" name="SubastaBLL">
        <generalization xmi:type="uml:Generalization" xmi:id="GEN_SubBLL_Abs" general="CLS_AbsBLL"/>
        <ownedOperation xmi:type="uml:Operation" xmi:id="CLS_SubBLL_Crear"    name="CrearSubasta"    visibility="public"/>
        <ownedOperation xmi:type="uml:Operation" xmi:id="CLS_SubBLL_Suscr"    name="Suscribir"       visibility="public"/>
        <ownedOperation xmi:type="uml:Operation" xmi:id="CLS_SubBLL_Desuscr"  name="Desuscribir"     visibility="public"/>
        <ownedOperation xmi:type="uml:Operation" xmi:id="CLS_SubBLL_Ofertar"  name="RealizarOferta"  visibility="public"/>
        <ownedOperation xmi:type="uml:Operation" xmi:id="CLS_SubBLL_Cerrar"   name="CerrarSubasta"   visibility="public"/>
        <ownedOperation xmi:type="uml:Operation" xmi:id="CLS_SubBLL_Hist"     name="ObtenerHistorial" visibility="public"/>
        <ownedOperation xmi:type="uml:Operation" xmi:id="CLS_SubBLL_Pujas"    name="ObtenerPujas"    visibility="public"/>
      </packagedElement>

      <packagedElement xmi:type="uml:Class" xmi:id="CLS_BitacoraBLL" name="BitacoraBLL">
        <ownedOperation xmi:type="uml:Operation" xmi:id="CLS_BitBLL_Reg"    name="Registrar"       visibility="public"/>
        <ownedOperation xmi:type="uml:Operation" xmi:id="CLS_BitBLL_ObtFil" name="ObtenerFiltrado" visibility="public"/>
      </packagedElement>

      <packagedElement xmi:type="uml:Class" xmi:id="CLS_UsuarioBLL" name="UsuarioBLL">
        <generalization xmi:type="uml:Generalization" xmi:id="GEN_UsrBLL_Abs" general="CLS_AbsBLL"/>
        <ownedOperation xmi:type="uml:Operation" xmi:id="CLS_UsrBLL_ObtTod" name="ObtenerTodos" visibility="public"/>
      </packagedElement>

    </packagedElement>

    <!-- ═══════════════════════════════════════════════════════
         CAPA 7 — GUI (Presentación)
         ═══════════════════════════════════════════════════════ -->
    <packagedElement xmi:type="uml:Package" xmi:id="PKG_GUI" name="GUI">

      <packagedElement xmi:type="uml:Class" xmi:id="CLS_frmLogin" name="frmLogin">
        <ownedOperation xmi:type="uml:Operation" xmi:id="CLS_frmL_InicSes" name="IniciarSesion_Click" visibility="private"/>
      </packagedElement>

      <packagedElement xmi:type="uml:Class" xmi:id="CLS_frmPrincipal" name="frmPrincipal">
        <ownedAttribute xmi:type="uml:Property"  xmi:id="CLS_frmP_Cat"     name="_catalogo: List&lt;IUnidadDeVenta&gt;" visibility="private"/>
        <ownedAttribute xmi:type="uml:Property"  xmi:id="CLS_frmP_Bit"     name="_bitacora: BitacoraBLL"                visibility="private"/>
        <ownedOperation xmi:type="uml:Operation" xmi:id="CLS_frmP_CargCat" name="CargarCatalogo"   visibility="private"/>
        <ownedOperation xmi:type="uml:Operation" xmi:id="CLS_frmP_AbrirF"  name="AbrirForm"        visibility="private"/>
      </packagedElement>

      <packagedElement xmi:type="uml:Class" xmi:id="CLS_frmCatalogo" name="frmCatalogo">
        <ownedAttribute xmi:type="uml:Property"  xmi:id="CLS_frmC_Cat"     name="_catalogo: List&lt;IUnidadDeVenta&gt;" visibility="private"/>
        <ownedOperation xmi:type="uml:Operation" xmi:id="CLS_frmC_Refres"  name="RefrescarVistas"  visibility="private"/>
        <ownedOperation xmi:type="uml:Operation" xmi:id="CLS_frmC_Filtro"  name="AplicarFiltro"    visibility="private"/>
      </packagedElement>

      <packagedElement xmi:type="uml:Class" xmi:id="CLS_frmSubasta" name="frmSubasta">
        <ownedAttribute xmi:type="uml:Property"  xmi:id="CLS_frmS_SA"      name="_subastaActiva: SubastaActiva" visibility="private"/>
        <ownedAttribute xmi:type="uml:Property"  xmi:id="CLS_frmS_Cat"     name="_catalogo: List&lt;IUnidadDeVenta&gt;" visibility="private"/>
        <ownedOperation xmi:type="uml:Operation" xmi:id="CLS_frmS_Iniciar" name="IniciarSubasta_Click" visibility="private"/>
        <ownedOperation xmi:type="uml:Operation" xmi:id="CLS_frmS_Cerrar"  name="CerrarSubasta_Click" visibility="private"/>
        <ownedOperation xmi:type="uml:Operation" xmi:id="CLS_frmS_Ofertar" name="Ofertar_Click"        visibility="private"/>
      </packagedElement>

      <packagedElement xmi:type="uml:Class" xmi:id="CLS_frmHistorial" name="frmHistorial">
        <ownedOperation xmi:type="uml:Operation" xmi:id="CLS_frmH_Carg" name="CargarHistorial" visibility="private"/>
      </packagedElement>

      <packagedElement xmi:type="uml:Class" xmi:id="CLS_frmReporte" name="frmReporte">
        <ownedAttribute xmi:type="uml:Property"  xmi:id="CLS_frmR_Cat"     name="_catalogo: List&lt;IUnidadDeVenta&gt;" visibility="private"/>
        <ownedOperation xmi:type="uml:Operation" xmi:id="CLS_frmR_Gen"     name="GenerarReporte"  visibility="private"/>
        <ownedOperation xmi:type="uml:Operation" xmi:id="CLS_frmR_ExpTXT"  name="ExportarTXT"     visibility="private"/>
        <ownedOperation xmi:type="uml:Operation" xmi:id="CLS_frmR_ExpPDF"  name="ExportarPDF"     visibility="private"/>
      </packagedElement>

      <packagedElement xmi:type="uml:Class" xmi:id="CLS_frmBitacora" name="frmBitacora">
        <ownedOperation xmi:type="uml:Operation" xmi:id="CLS_frmB_Carg" name="CargarEventos" visibility="private"/>
      </packagedElement>

    </packagedElement>

    <!-- ═══════════════════════════════════════════════════════
         DEPENDENCIAS ENTRE CAPAS
         ═══════════════════════════════════════════════════════ -->

    <!-- DAL usa Acceso (Singleton) -->
    <packagedElement xmi:type="uml:Dependency" xmi:id="DEP_AbsDAL_Acc"   client="CLS_AbsDAL"    supplier="CLS_Acceso"/>
    <packagedElement xmi:type="uml:Dependency" xmi:id="DEP_CatDAL_Acc"   client="CLS_CatalogoDAL" supplier="CLS_Acceso"/>

    <!-- BLL usa DAL -->
    <packagedElement xmi:type="uml:Dependency" xmi:id="DEP_CatBLL_CatDAL"  client="CLS_CatalogoBLL" supplier="CLS_CatalogoDAL"/>
    <packagedElement xmi:type="uml:Dependency" xmi:id="DEP_SubBLL_SubDAL"  client="CLS_SubastaBLL"  supplier="CLS_SubastaDAL"/>
    <packagedElement xmi:type="uml:Dependency" xmi:id="DEP_SubBLL_PujDAL"  client="CLS_SubastaBLL"  supplier="CLS_PujaDAL"/>
    <packagedElement xmi:type="uml:Dependency" xmi:id="DEP_SubBLL_Acc"     client="CLS_SubastaBLL"  supplier="CLS_Acceso"/>
    <packagedElement xmi:type="uml:Dependency" xmi:id="DEP_BitBLL_BitDAL"  client="CLS_BitacoraBLL" supplier="CLS_BitacoraDAL"/>
    <packagedElement xmi:type="uml:Dependency" xmi:id="DEP_UsrBLL_UsrDAL"  client="CLS_UsuarioBLL"  supplier="CLS_UsuarioDAL"/>
    <packagedElement xmi:type="uml:Dependency" xmi:id="DEP_SEG_MartDAL"    client="CLS_SessionManager" supplier="CLS_MartilleroDAL"/>

    <!-- BLL usa Servicios -->
    <packagedElement xmi:type="uml:Dependency" xmi:id="DEP_SubBLL_SA"      client="CLS_SubastaBLL"  supplier="CLS_SubastaActiva"/>
    <packagedElement xmi:type="uml:Dependency" xmi:id="DEP_BitBLL_SM"      client="CLS_BitacoraBLL" supplier="CLS_SessionManager"/>

    <!-- Servicios usa Singleton -->
    <packagedElement xmi:type="uml:Dependency" xmi:id="DEP_SA_GestorPujas" client="CLS_SubastaActiva" supplier="CLS_GestorPujas"/>

    <!-- GUI usa BLL y Seguridad -->
    <packagedElement xmi:type="uml:Dependency" xmi:id="DEP_frmL_SM"        client="CLS_frmLogin"     supplier="CLS_SessionManager"/>
    <packagedElement xmi:type="uml:Dependency" xmi:id="DEP_frmP_CatBLL"    client="CLS_frmPrincipal" supplier="CLS_CatalogoBLL"/>
    <packagedElement xmi:type="uml:Dependency" xmi:id="DEP_frmP_BitBLL"    client="CLS_frmPrincipal" supplier="CLS_BitacoraBLL"/>
    <packagedElement xmi:type="uml:Dependency" xmi:id="DEP_frmP_SM"        client="CLS_frmPrincipal" supplier="CLS_SessionManager"/>
    <packagedElement xmi:type="uml:Dependency" xmi:id="DEP_frmC_CatBLL"    client="CLS_frmCatalogo"  supplier="CLS_CatalogoBLL"/>
    <packagedElement xmi:type="uml:Dependency" xmi:id="DEP_frmS_SubBLL"    client="CLS_frmSubasta"   supplier="CLS_SubastaBLL"/>
    <packagedElement xmi:type="uml:Dependency" xmi:id="DEP_frmS_BitBLL"    client="CLS_frmSubasta"   supplier="CLS_BitacoraBLL"/>
    <packagedElement xmi:type="uml:Dependency" xmi:id="DEP_frmH_SubBLL"    client="CLS_frmHistorial" supplier="CLS_SubastaBLL"/>
    <packagedElement xmi:type="uml:Dependency" xmi:id="DEP_frmR_SubBLL"    client="CLS_frmReporte"   supplier="CLS_SubastaBLL"/>
    <packagedElement xmi:type="uml:Dependency" xmi:id="DEP_frmR_CatBLL"    client="CLS_frmReporte"   supplier="CLS_CatalogoBLL"/>
    <packagedElement xmi:type="uml:Dependency" xmi:id="DEP_frmB_BitBLL"    client="CLS_frmBitacora"  supplier="CLS_BitacoraBLL"/>

  </uml:Model>
</xmi:XMI>
