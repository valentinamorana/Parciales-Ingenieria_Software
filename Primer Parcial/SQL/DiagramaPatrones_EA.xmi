<?xml version="1.0" encoding="UTF-8"?>
<xmi:XMI xmi:version="2.1"
  xmlns:uml="http://www.omg.org/spec/UML/20090901"
  xmlns:xmi="http://www.omg.org/spec/XMI/20090901">

  <xmi:Documentation exporter="AlmonedaNacional-Patrones" exporterVersion="1.0"/>

  <uml:Model xmi:type="uml:Model" xmi:id="MODEL_AN" name="LaAlmonedaNacional">
    <packagedElement xmi:type="uml:Package" xmi:id="PKG_ALL" name="AlmonedaNacional">

      <!-- ══ INTERFACES ══ -->

      <packagedElement xmi:type="uml:Interface" xmi:id="IFC_IObs" name="IObservadorSubasta">
        <ownedOperation xmi:type="uml:Operation" xmi:id="O_IObs_Act"
                        name="Actualizar(subasta: SubastaActiva, mensaje: string): void" visibility="public"/>
      </packagedElement>

      <packagedElement xmi:type="uml:Interface" xmi:id="IFC_IUdV" name="IUnidadDeVenta">
        <ownedAttribute xmi:type="uml:Property" xmi:id="A_IUdV_Nombre"
                        name="Nombre: string" visibility="protected"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="A_IUdV_Estado"
                        name="Estado: EstadoUnidad" visibility="public"/>
        <ownedOperation xmi:type="uml:Operation" xmi:id="O_IUdV_Precio"
                        name="CalcularPrecioBase(): decimal" visibility="public"/>
        <ownedOperation xmi:type="uml:Operation" xmi:id="O_IUdV_Desc"
                        name="ObtenerDescripcion(): string" visibility="public"/>
        <ownedOperation xmi:type="uml:Operation" xmi:id="O_IUdV_Agr"
                        name="Agregar(u: IUnidadDeVenta): void" visibility="public"/>
        <ownedOperation xmi:type="uml:Operation" xmi:id="O_IUdV_Quit"
                        name="Quitar(u: IUnidadDeVenta): void" visibility="public"/>
      </packagedElement>

      <!-- ══ CLASES ══ -->

      <!-- Sujeto concreto del Observer -->
      <packagedElement xmi:type="uml:Class" xmi:id="CLS_SA" name="SubastaActiva">
        <ownedAttribute xmi:type="uml:Property" xmi:id="A_SA_Unidad"
                        name="Unidad: IUnidadDeVenta" visibility="public"
                        type="IFC_IUdV" association="ASSOC_SA_UdV">
          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="UV_SA_UdV" value="1"/>
          <lowerValue xmi:type="uml:LiteralInteger"          xmi:id="LV_SA_UdV" value="1"/>
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="A_SA_PrecioActual"
                        name="PrecioActual: decimal" visibility="public"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="A_SA_Ganador"
                        name="UltimoPujador: Usuario" visibility="public"
                        type="CLS_Usr" association="ASSOC_SA_Usr">
          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="UV_SA_Usr" value="1"/>
          <lowerValue xmi:type="uml:LiteralInteger"          xmi:id="LV_SA_Usr" value="0"/>
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="A_SA_FechaHora"
                        name="FechaHora: DateTime" visibility="public"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="A_SA_Obs"
                        name="Suscriptores: List&lt;IObservadorSubasta&gt;" visibility="public"
                        aggregation="shared" type="IFC_IObs" association="ASSOC_SA_Obs">
          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="UV_SA_Obs" value="*"/>
          <lowerValue xmi:type="uml:LiteralInteger"          xmi:id="LV_SA_Obs" value="0"/>
        </ownedAttribute>
        <ownedOperation xmi:type="uml:Operation" xmi:id="O_SA_Suscr"
                        name="Suscribir(obs: IObservadorSubasta): void" visibility="public"/>
        <ownedOperation xmi:type="uml:Operation" xmi:id="O_SA_Desuscr"
                        name="Desuscribir(obs: IObservadorSubasta): void" visibility="public"/>
        <ownedOperation xmi:type="uml:Operation" xmi:id="O_SA_Notif"
                        name="Notificar(mensaje: string): void" visibility="public"/>
        <ownedOperation xmi:type="uml:Operation" xmi:id="O_SA_Ofertar"
                        name="RealizarOferta(u: Usuario, monto: decimal): void" visibility="public"/>
        <ownedOperation xmi:type="uml:Operation" xmi:id="O_SA_Cerrar"
                        name="Cerrar(): ResultadoSubasta" visibility="public"/>
      </packagedElement>

      <!-- Observador concreto -->
      <packagedElement xmi:type="uml:Class" xmi:id="CLS_Int" name="Interesado">
        <interfaceRealization xmi:type="uml:InterfaceRealization" xmi:id="REAL_Int_IObs"
                              supplier="IFC_IObs" client="CLS_Int"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="A_Int_Usr"
                        name="Usuario: Usuario" visibility="public"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="A_Int_Canal"
                        name="Canal: string" visibility="public"/>
        <ownedOperation xmi:type="uml:Operation" xmi:id="O_Int_Act"
                        name="Actualizar(subasta: SubastaActiva, mensaje: string): void" visibility="public"/>
      </packagedElement>

      <!-- Usuario -->
      <packagedElement xmi:type="uml:Class" xmi:id="CLS_Usr" name="Usuario">
        <ownedAttribute xmi:type="uml:Property" xmi:id="A_Usr_Nom"
                        name="Nombre: string" visibility="private"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="A_Usr_Email"
                        name="Email: string" visibility="private"/>
      </packagedElement>

      <!-- Artículo (Hoja del Composite) -->
      <packagedElement xmi:type="uml:Class" xmi:id="CLS_Art" name="ArticuloSimple">
        <interfaceRealization xmi:type="uml:InterfaceRealization" xmi:id="REAL_Art_IUdV"
                              supplier="IFC_IUdV" client="CLS_Art"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="A_Art_Nom"
                        name="Nombre: string" visibility="public"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="A_Art_Precio"
                        name="PrecioBase: decimal" visibility="public"/>
        <ownedOperation xmi:type="uml:Operation" xmi:id="O_Art_Precio"
                        name="CalcularPrecioBase(): decimal" visibility="public"/>
        <ownedOperation xmi:type="uml:Operation" xmi:id="O_Art_Desc"
                        name="ObtenerDescripcion(): string" visibility="public"/>
      </packagedElement>

      <!-- Lote (Compuesto del Composite) -->
      <packagedElement xmi:type="uml:Class" xmi:id="CLS_Lote" name="LoteArticulos">
        <interfaceRealization xmi:type="uml:InterfaceRealization" xmi:id="REAL_Lote_IUdV"
                              supplier="IFC_IUdV" client="CLS_Lote"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="A_Lote_Nom"
                        name="Nombre: string" visibility="public"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="A_Lote_Comp"
                        name="_contenido: List&lt;IUnidadDeVenta&gt;" visibility="private"
                        aggregation="composite" type="IFC_IUdV" association="ASSOC_Lote_UdV">
          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="UV_Lote" value="*"/>
          <lowerValue xmi:type="uml:LiteralInteger"          xmi:id="LV_Lote" value="0"/>
        </ownedAttribute>
        <ownedOperation xmi:type="uml:Operation" xmi:id="O_Lote_Precio"
                        name="CalcularPrecioBase(): decimal" visibility="public"/>
        <ownedOperation xmi:type="uml:Operation" xmi:id="O_Lote_Desc"
                        name="ObtenerDescripcion(): string" visibility="public"/>
        <ownedOperation xmi:type="uml:Operation" xmi:id="O_Lote_Agr"
                        name="Agregar(u: IUnidadDeVenta): void" visibility="public"/>
        <ownedOperation xmi:type="uml:Operation" xmi:id="O_Lote_Quit"
                        name="Quitar(u: IUnidadDeVenta): void" visibility="public"/>
      </packagedElement>

      <!-- Singleton GestorDePujasSingleton -->
      <packagedElement xmi:type="uml:Class" xmi:id="CLS_GP"
                       name="GestorDePujasSingleton" isFinalSpecialization="true">
        <ownedAttribute xmi:type="uml:Property" xmi:id="A_GP_Inst"
                        name="_instancia: GestorDePujasSingleton" visibility="private" isStatic="true"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="A_GP_Lock"
                        name="_lock: object" visibility="private" isStatic="true"/>
        <ownedOperation xmi:type="uml:Operation" xmi:id="O_GP_Ctor"
                        name="GestorDePujasSingleton()" visibility="private"/>
        <ownedOperation xmi:type="uml:Operation" xmi:id="O_GP_GetInst"
                        name="GetInstance(): GestorDePujasSingleton" visibility="public" isStatic="true"/>
        <ownedOperation xmi:type="uml:Operation" xmi:id="O_GP_Ej"
                        name="EjecutarBajoLock(op: Action): void" visibility="public"/>
      </packagedElement>

      <!-- ══ ASOCIACIONES NAVEGABLES ══ -->

      <packagedElement xmi:type="uml:Association" xmi:id="ASSOC_SA_UdV" name="">
        <memberEnd xmi:idref="A_SA_Unidad"/>
        <ownedEnd xmi:type="uml:Property" xmi:id="ASSOC_SA_UdV_End" type="CLS_SA"/>
      </packagedElement>

      <packagedElement xmi:type="uml:Association" xmi:id="ASSOC_SA_Usr" name="">
        <memberEnd xmi:idref="A_SA_Ganador"/>
        <ownedEnd xmi:type="uml:Property" xmi:id="ASSOC_SA_Usr_End" type="CLS_SA"/>
      </packagedElement>

      <packagedElement xmi:type="uml:Association" xmi:id="ASSOC_SA_Obs" name="">
        <memberEnd xmi:idref="A_SA_Obs"/>
        <ownedEnd xmi:type="uml:Property" xmi:id="ASSOC_SA_Obs_End" type="CLS_SA"/>
      </packagedElement>

      <packagedElement xmi:type="uml:Association" xmi:id="ASSOC_Lote_UdV" name="">
        <memberEnd xmi:idref="A_Lote_Comp"/>
        <ownedEnd xmi:type="uml:Property" xmi:id="ASSOC_Lote_UdV_End" type="CLS_Lote"/>
      </packagedElement>

      <!-- Interesado usa Usuario -->
      <packagedElement xmi:type="uml:Dependency" xmi:id="DEP_Int_Usr"
                       client="CLS_Int" supplier="CLS_Usr"/>

      <!-- GestorDePujasSingleton usa SubastaActiva -->
      <packagedElement xmi:type="uml:Dependency" xmi:id="DEP_GP_SA"
                       client="CLS_GP" supplier="CLS_SA"/>

    </packagedElement>
  </uml:Model>

  <!-- ══ LAYOUT VISUAL PARA EA ══ -->
  <xmi:Extension extender="Enterprise Architect" extenderID="6.5">
    <diagrams>
      <diagram xmi:id="DIAG_1">
        <model package="PKG_ALL" localID="1" owner="PKG_ALL"/>
        <properties name="Diagrama de Clases - Patrones" type="Logical"/>
        <elements>
          <!-- IObservadorSubasta — arriba izquierda -->
          <element subject="IFC_IObs"  seqno="1"  style="Left=20;Top=80;Right=230;Bottom=165;"/>
          <!-- SubastaActiva — arriba centro -->
          <element subject="CLS_SA"    seqno="2"  style="Left=280;Top=20;Right=580;Bottom=275;"/>
          <!-- IUnidadDeVenta — arriba derecha -->
          <element subject="IFC_IUdV"  seqno="3"  style="Left=630;Top=60;Right=850;Bottom=200;"/>
          <!-- Interesado — izquierda medio -->
          <element subject="CLS_Int"   seqno="4"  style="Left=20;Top=310;Right=230;Bottom=415;"/>
          <!-- Usuario — centro medio -->
          <element subject="CLS_Usr"   seqno="5"  style="Left=310;Top=340;Right=490;Bottom=435;"/>
          <!-- ArticuloSimple — derecha medio -->
          <element subject="CLS_Art"   seqno="6"  style="Left=550;Top=330;Right=740;Bottom=445;"/>
          <!-- LoteArticulos — derecha -->
          <element subject="CLS_Lote"  seqno="7"  style="Left=770;Top=310;Right=990;Bottom=460;"/>
          <!-- GestorDePujasSingleton — abajo centro -->
          <element subject="CLS_GP"    seqno="8"  style="Left=265;Top=490;Right=575;Bottom=625;"/>
        </elements>
        <connectors>
          <connector subject="REAL_Int_IObs"/>
          <connector subject="REAL_Art_IUdV"/>
          <connector subject="REAL_Lote_IUdV"/>
          <connector subject="ASSOC_SA_UdV"/>
          <connector subject="ASSOC_SA_Usr"/>
          <connector subject="ASSOC_SA_Obs"/>
          <connector subject="ASSOC_Lote_UdV"/>
          <connector subject="DEP_Int_Usr"/>
          <connector subject="DEP_GP_SA"/>
        </connectors>
      </diagram>
    </diagrams>
  </xmi:Extension>

</xmi:XMI>
